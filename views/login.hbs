{{> nHeader }}

<style>
  :root {
    --accent: #ff00aa;
    --accent2: #9900ff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
    background: radial-gradient(circle at top, #0d0d0d, #1a1a1a);
    color: #fff;
  }
  body::before {
    content: '';
    position: fixed;
    inset: -50%;
    background: conic-gradient(var(--accent), var(--accent2), #00ffee, var(--accent));
    filter: blur(200px);
    z-index: 0;
    animation: spin 14s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .notes_wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .register.cua {
    width: 360px;
    max-width: 92vw;
    padding: 1.85rem;
    border-radius: 14px;
    background: rgba(20,20,20,0.9);
    box-shadow: 0 8px 40px rgba(0,0,0,0.6);
    border: 1px solid rgba(255,255,255,0.03);
    text-align: center;
  }
  .register.cua .display_text span {
    display: block;
    font-size: 1.4rem;
    margin-bottom: 1rem;
    text-shadow: 0 0 8px var(--accent);
  }
  .register.cua input[type="text"],
  .register.cua input[type="password"] {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border-radius: 8px;
    border: none;
    background: rgba(255,255,255,0.06);
    color: #fff;
    font-size: 1rem;
    outline: none;
    transition: box-shadow .15s;
    margin-bottom: 0.8rem;
  }
  .register.cua input:focus {
    box-shadow: 0 0 12px rgba(255,0,170,0.18);
    background: rgba(255,255,255,0.08);
  }
  .register.cua .l_submit {
    width: 100%;
    margin-top: 6px;
    padding: 0.8rem;
    border-radius: 8px;
    border: none;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    cursor: pointer;
  }
  .register.cua .l_submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255,0,170,0.15);
  }
  .log_sign {
    position: absolute;
    top: 20px;
    right: 20px;
  }
  .pri_btn {
    background: var(--accent);
    color: #fff;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
  }
  .pri_btn:hover {
    box-shadow: 0 0 10px var(--accent);
  }
  .forgot_psswrd {
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .forgot_psswrd a {
    color: var(--accent);
    text-decoration: none;
  }
  .forgot_psswrd a:hover {
    text-shadow: 0 0 5px var(--accent);
  }
</style>

<div class="notes_wrapper">
  <div class="log_sign">
    <a href="/signup" class="pri_btn">Need an account?</a>
  </div>

  <div class="register cua">
    <div class="display_text">
      <span>Get started again</span>
    </div>
    <form class="form_login">
      <input type="text" name="username" value="" class="l_username" autofocus required spellcheck="false" autocomplete='false' placeholder='Username'>
      <input type="password" name="password" value="" class="l_password" id='l_password' required placeholder='Password'>
      <span class="show_psswrd s_p_l">
        <i class="fas fa-lock"></i>
      </span>
      <input type="submit" value="Login To Continue" class="l_submit">
    </form>
    <div class="forgot_psswrd">
      <a href="forgot-password" class="a_pri" alt="Forgot your password">Forgot your password?</a>
    </div>
  </div>
</div>

{{> quickLogin}}

{{> footer }}
